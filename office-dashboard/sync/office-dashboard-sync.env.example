# Copy to ~/.config/office-dashboard-sync.env (mode 600) and fill in. Never commit the real file.

# Google Calendar "Secret address in iCal format"; several may be separated by spaces.
CALENDAR_ICS_URL=REPLACE_ME

# Cloudflare: custom API token with Account > Workers KV Storage > Edit, plus the account id and
# the CALENDAR namespace id (`npx wrangler kv namespace list`).
CF_API_TOKEN=REPLACE_ME
CF_ACCOUNT_ID=REPLACE_ME
CF_KV_NAMESPACE_ID=REPLACE_ME

# IANA time zone used to expand recurring and all-day events, e.g. Europe/London.
TZ=REPLACE_ME

# Absolute path to this sync/ folder in your checkout.
SYNC_DIR=/home/YOU/src/photo-frame-dashboard/office-dashboard/sync

# Command that runs Node 20+. With nvm, nvm-exec picks the newest installed NODE_VERSION.
# Keep the quotes: the value has a space.
NODE_CMD="/home/YOU/.nvm/nvm-exec node"
NODE_VERSION=22
# Or a system Node instead: NODE_CMD=/usr/bin/node
